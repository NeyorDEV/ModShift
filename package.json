{
  "name": "modshift",
  "version": "0.1.0",
  "description": "Migrate a Minecraft modpack to another Minecraft version and/or mod loader (Forge, NeoForge, Fabric, Quilt).",
  "keywords": [
    "minecraft",
    "modpack",
    "modrinth",
    "forge",
    "neoforge",
    "fabric",
    "quilt",
    "cli"
  ],
  "homepage": "https://github.com/NeyorDEV/ModShift#readme",
  "bugs": {
    "url": "https://github.com/NeyorDEV/ModShift/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeyorDEV/ModShift.git"
  },
  "license": "MIT",
  "author": "NeyorDEV",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "modshift": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.html",
    "dist/**/*.css",
    "schemas",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^20.17.0 || >=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-ui-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.3",
    "commander": "^14.0.3",
    "fflate": "^0.8.3",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  }
}
