{
  "name": "modshift",
  "version": "0.1.0",
  "description": "Migrate a Minecraft modpack to another Minecraft version and/or mod loader (Forge, NeoForge, Fabric, Quilt).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "modshift": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "minecraft",
    "modpack",
    "modrinth",
    "forge",
    "neoforge",
    "fabric",
    "quilt",
    "cli"
  ],
  "dependencies": {
    "commander": "^14.0.3",
    "fflate": "^0.8.3",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  }
}
